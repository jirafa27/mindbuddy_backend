# Backend Settings
PROJECT_NAME=MindBuddy
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/mindbuddy
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# LLM Providers
OPENROUTER_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here

# Yandex Cloud API
# Можно использовать либо YANDEX_IAM_TOKEN напрямую, либо YANDEX_OAUTH_TOKEN для автоматического получения IAM-токена
YANDEX_IAM_TOKEN=your_iam_token_here
YANDEX_OAUTH_TOKEN=your_oauth_token_here
YANDEX_FOLDER_ID=your_folder_id_here

# Security
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

