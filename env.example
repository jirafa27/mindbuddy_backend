# Backend Settings
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/mindbuddy
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# MinIO / S3 Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=mindbuddy-files
MINIO_BUCKET_TEMP_BLOBS=temp-blobs
MINIO_SECURE=false

# LLM Providers
OPENROUTER_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here

# Yandex Cloud API
YANDEX_OAUTH_TOKEN=your_oauth_token_here
YANDEX_FOLDER_ID=your_folder_id_here
# Окно контекста и запас для суммаризации (опционально, по умолчанию 32000 и 2000)
# YANDEX_COMPLETION_CONTEXT_TOKENS=32000
# YANDEX_SUMMARY_CONTEXT_RESERVE=2000

# User-Agent для yt_dlp (опционально, по умолчанию Chrome-подобный)
# USER_AGENT=

